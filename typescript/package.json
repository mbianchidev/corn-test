{
  "name": "corn-test-typescript",
  "version": "1.0.0",
  "description": "Sample TypeScript app with flaky tests for testing purposes",
  "scripts": {
    "build": "tsc",
    "test:jest": "jest --ci --reporters=default --reporters=jest-junit",
    "test:playwright": "playwright test",
    "test": "npm run test:jest && npm run test:playwright"
  },
  "overrides": {
    "uuid": "^14.0.0",
    "@babel/core": "7.29.7",
    "js-yaml": "5.2.2",
    "test-exclude": "7.0.2",
    "minimatch": "10.2.5",
    "brace-expansion": "5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/jest": "^30.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "jest": "^30.4.2",
    "jest-junit": "^17.0.0",
    "ts-jest": "^29.4.12",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
